# 复制成 .env 之后填真实值：copy .env.example .env
# .env 已在 .gitignore 里，不会被提交。
#
# ⚠️ config/config.toml.docker 是被 git 跟踪的，里面 emailConfig.authcode 和
#    voiceServiceConfig 的两个 Key 是明文。用这个项目做作品集之前，
#    请去对应服务商后台把它们轮换掉（密钥进过 git 历史就等于已泄露）。

# ---------------- 模型 API Key ----------------
# 阿里百炼（DashScope）的 Key。config.toml.docker 里 ragModelConfig.apiKey 留空时读这个
ALIYUN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：用 modelType=1（DeepSeek 直连）时才需要
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------- 数据库 ----------------
# 改了这里，也要同步改 config/config.toml.docker 里的 [mysqlConfig] password
MYSQL_ROOT_PASSWORD=050922

# ---------------- RabbitMQ ----------------
RABBITMQ_DEFAULT_USER=root
RABBITMQ_DEFAULT_PASS=123456

# ---------------- 宿主机端口映射 ----------------
# 左边都是宿主机端口。默认刻意避开本机开发常用的 3306/6379/5672/15672，
# 免得和你已经装好的 MySQL、Redis、RabbitMQ 抢端口。
# 容器内部端口不变，所以配置文件里写的永远是标准端口。
WEB_PORT=8080
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
RABBITMQ_HOST_PORT=5673
RABBITMQ_UI_HOST_PORT=15673
