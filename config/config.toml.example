[mainConfig]
appName = "DeepTalk"
host = "0.0.0.0"
port = 9090

[emailConfig]
authcode = "your-qq-email-authcode"
email = "your-email@qq.com"

[redisConfig]
host = "127.0.0.1"
port = 6379
password = ""
db = 0

[mysqlConfig]
host = "127.0.0.1"
port = 3306
user = "root"
password = "your-mysql-password"
databaseName = "deeptalk"
charset = "utf8mb4"

[jwtConfig]
expire_duration = 8760
issuer = "immortal"
subject = "DeepTalk"
key = "your-jwt-secret-key"

[rabbitmqConfig]
host = "127.0.0.1"
port = 5672
username = "root"
password = "your-rabbitmq-password"
vhost = "/"

[ragModelConfig]
embeddingModel = "text-embedding-v4"
chatModelName = "qwen-turbo"
docDir = "./docs"
baseUrl = "https://dashscope.aliyuncs.com/compatible-mode/v1"
dimension = 1024
apiKey = "your-dashscope-api-key"
maxContextTokens = 4000
maxDistance = 0.5            # 相关性阈值（余弦距离，越小越严格）；召回低就放宽到 0.7
fallbackTopN = 3             # 全都没过阈值时至少保留几条分片


# ============ 模型计费与可观测（元 / 100 万 token）============
# 用于把每次请求的 token 换算成费用，并累计到 /metrics
[aiPricing]
defaultPromptPrice = 2.0
defaultCompletionPrice = 8.0
dailyTokenQuota = 0            # 每用户每日 token 配额，0 = 不限

[aiPricing.promptPrice]
deepseek-chat = 2.0            # 输入价（元/1M token）
qwen-turbo = 0.3

[aiPricing.completionPrice]
deepseek-chat = 8.0            # 输出价（元/1M token）
qwen-turbo = 0.6

# ============ 提示词 ============
# 稳定的系统提示放在消息最前面，有利于命中上游 prompt 前缀缓存
[aiPrompt]
systemPrompt = "你是 DeepTalk 的智能助手。回答简洁、准确、有依据；不确定时明确说明，不要编造。"

# ============ 语义缓存 ============
# 相似问题直接返回缓存答案（省一次 LLM 调用）
[semanticCache]
enabled = true
threshold = 0.92               # 余弦相似度阈值，越高越保守
maxEntries = 500
ttlSeconds = 3600

# ============ MCP 工具注册表 ============
# 想给 AI 加工具时，在这里声明 MCP 服务端即可（支持多个，allowedTools 为空表示全部允许）
[mcpConfig]
maxStep = 5                    # Agent 最大推理步数

# 方式一：远程 HTTP（StreamableHTTP）
[[mcpConfig.servers]]
name = "weather"
url = "http://localhost:8081/mcp"
allowedTools = ["get_weather"]

# 方式二：本地子进程（社区工具大多是 npx / uvx 启动的 stdio 服务）
# [[mcpConfig.servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "C:/data"]
# env = ["LOG_LEVEL=info"]
# allowedTools = ["read_file", "list_directory"]   # 目录类工具建议按需白名单

# [[mcpConfig.servers]]
# name = "fetch"
# command = "uvx"
# args = ["mcp-server-fetch"]


# ============ 熔断器（sony/gobreaker）============
[resilience]
disabled = false
failureThreshold = 5           # 连续失败 5 次跳闸
failureRatio = 0.6             # 或失败率 60%（需 minRequests 以上样本）
minRequests = 10
timeoutSeconds = 30            # open 持续 30 秒后进入 half-open 试探
maxRequestsHalfOpen = 3        # half-open 允许的试探请求数
intervalSeconds = 60           # 关闭态计数窗口滚动周期

# ============ 意图识别（分层：规则层 + LLM 兜底）============
# 规则层（加权词表 + 整词匹配 + 指代/疑问词守卫）永远生效且零成本；
# llmFallback 开启后，规则层"不确定"的少量请求（实测约 7%）才用 LLM 做结构化分类
[intentConfig]
llmFallback = true
cacheTTLSeconds = 600          # 同一问题在此时间内只判一次
maxCacheEntries = 1000

# ============ 限流（令牌桶）============
# 不配这一段时用默认值，行为与历史一致：单用户 10 容量 / 每秒补 2 个（≈2 QPS）。
# 压测时把 enabled 设为 false 临时关掉，压完务必改回 true。
[rateLimit]
enabled = true
capacity = 10                  # 单用户桶容量（突发允许几个请求）
refill = 2                     # 单用户每秒补充 token 数
ipCapacity = 5                 # 未登录接口按 IP：桶容量
ipRefill = 0.2                 # 未登录接口按 IP：每 5 秒补 1 个

# ============ 诊断端点（压测 / 排查用）============
# 打开后会启动 pprof 服务，并开启 goroutine / heap / block / mutex 采样。
# 采样有开销，且 pprof 能 dump 出完整堆栈，生产环境务必保持 false。
[debug]
pprofEnabled = false
pprofAddr = "127.0.0.1:6060"   # 只监听本机；要远程看请走 SSH 隧道

# ============ Agent 可靠性 ============
# Agent 每多走一步就要一次模型调用（成本与延迟线性增长），
# 下面这些上限保证它"不会跑飞、不会挂死"：
#   单步超时     → 工具/模型卡住不会拖死整轮
#   整轮墙钟     → 超时返回已产出的部分内容，而不是 500
#   步数与 token → 触顶即停止，避免无限循环烧钱
[agent]
maxSteps = 8                 # 单轮最大推理步数
maxTokens = 20000            # 单轮累计 token 上限
maxWallClockSeconds = 120    # 单轮墙钟上限（秒）
toolTimeoutSeconds = 15      # 单次工具调用超时（秒）
modelTimeoutSeconds = 60     # 单次模型调用超时（秒）
toolMaxAttempts = 2          # 幂等工具最大尝试次数（含首次）

# ============ 模型兜底链 ============
# 主模型失败 → 原模型重试一次 → 依次尝试备用模型 → 返回错误码。
# 备用模型与主模型共用 ragModelConfig 的 baseUrl / apiKey，只换模型名；
# 写错型号名只会被跳过并记日志，不会让 Agent 组装失败。
[llm]
fallbackModels = ["qwen-turbo", "deepseek-chat"]
# ============ 推理请求调度 ============
# 把"每个请求直接调用模型"改成"先排队、再按槽位分发"：
# 上游并发可控；过载时快速失败，而不是所有请求一起超时。
[inference]
enabled = true
queueTimeoutMs = 3000        # 排队超过此时长直接拒绝
maxQueueDepth = 200          # 每个模型的队列长度上限，超出直接拒绝

# 每个模型一个池子；未在这里列出的模型走默认值（并发 10）
[inference.pools.qwen-turbo]
maxConcurrent = 30
weight = 10

[inference.pools.deepseek-chat]
maxConcurrent = 20
weight = 10

# 准入熔断：连续失败 N 次后在**入队之前**快速拒绝。
# 与 [resilience] 的模型熔断分工不同：那个按失败率保护"调用"，
# 这个按连续失败数避免把已知故障模型的队列排满。
[inference.breaker]
failureThreshold = 5
openDurationMs = 10000
halfOpenProbes = 3
# ============ RAG 指代消解（Query Rewrite）============
# 意图层能识别"含指代词、依赖上下文"，但检索仍拿原句去查——
# 用户问"那它呢"，等于用"那它呢"做向量检索，召回接近随机。
# 这一段在检索前把指代替换成上文里的实体。
[ragRewrite]
enabled = true
timeoutMs = 800              # 超时即回退原句：改写是锦上添花，不能拖慢主链路
# ============ 多级答案缓存 ============
# 分层是为了**成本**，不只是命中率：
#   L1 精确命中 = 0 次模型调用 + 0 次 embedding 调用
#   L2 语义命中 = 0 次模型调用 + 1 次 embedding 调用
# 语义缓存得先把问题向量化才能比相似度，这一步本身就是外部调用；
# L1 用"模型+问题"的 hash 绕过了它。
[cache]
enabled = true
exactTTLSeconds = 300        # L1 有效期（L2 的 TTL/阈值仍由 [semanticCache] 配置）
exactMaxEntries = 10000      # L1 容量上限（本地 LRU）
jitterRatio = 0.2            # TTL 抖动 ±20%：防止一批 key 同时失效（缓存雪崩）

[cache.penetration]
# 空结果（模型拒答）也缓存，但 TTL 短得多：文档补上后能很快恢复
emptyResultTTLSeconds = 30