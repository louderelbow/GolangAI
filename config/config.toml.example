[mainConfig]
appName = "DeepTalk"
host = "0.0.0.0"
port = 9090

[emailConfig]
authcode = "your-qq-email-authcode"
email = "your-email@qq.com"

[redisConfig]
host = "127.0.0.1"
port = 6379
password = ""
db = 0

[mysqlConfig]
host = "127.0.0.1"
port = 3306
user = "root"
password = "your-mysql-password"
databaseName = "deeptalk"
charset = "utf8mb4"

[jwtConfig]
expire_duration = 8760
issuer = "immortal"
subject = "DeepTalk"
key = "your-jwt-secret-key"

[rabbitmqConfig]
host = "127.0.0.1"
port = 5672
username = "root"
password = "your-rabbitmq-password"
vhost = "/"

[ragModelConfig]
embeddingModel = "text-embedding-v4"
chatModelName = "qwen-turbo"
docDir = "./docs"
baseUrl = "https://dashscope.aliyuncs.com/compatible-mode/v1"
dimension = 1024
apiKey = "your-dashscope-api-key"
maxContextTokens = 4000
maxDistance = 0.5            # 相关性阈值（余弦距离，越小越严格）；召回低就放宽到 0.7
fallbackTopN = 3             # 全都没过阈值时至少保留几条分片

[voiceServiceConfig]
voiceServiceApiKey = "your-voice-service-api-key"
voiceServiceSecretKey = "your-voice-service-secret-key"


# ============ 模型计费与可观测（元 / 100 万 token）============
# 用于把每次请求的 token 换算成费用，并累计到 /metrics
[aiPricing]
defaultPromptPrice = 2.0
defaultCompletionPrice = 8.0
dailyTokenQuota = 0            # 每用户每日 token 配额，0 = 不限

[aiPricing.promptPrice]
deepseek-chat = 2.0            # 输入价（元/1M token）
qwen-turbo = 0.3

[aiPricing.completionPrice]
deepseek-chat = 8.0            # 输出价（元/1M token）
qwen-turbo = 0.6

# ============ 提示词 ============
# 稳定的系统提示放在消息最前面，有利于命中上游 prompt 前缀缓存
[aiPrompt]
systemPrompt = "你是 DeepTalk 的智能助手。回答简洁、准确、有依据；不确定时明确说明，不要编造。"

# ============ 语义缓存 ============
# 相似问题直接返回缓存答案（省一次 LLM 调用）
[semanticCache]
enabled = true
threshold = 0.92               # 余弦相似度阈值，越高越保守
maxEntries = 500
ttlSeconds = 3600

# ============ MCP 工具注册表 ============
# 想给 AI 加工具时，在这里声明 MCP 服务端即可（支持多个，allowedTools 为空表示全部允许）
[mcpConfig]
maxStep = 5                    # Agent 最大推理步数

# 方式一：远程 HTTP（StreamableHTTP）
[[mcpConfig.servers]]
name = "weather"
url = "http://localhost:8081/mcp"
allowedTools = ["get_weather"]

# 方式二：本地子进程（社区工具大多是 npx / uvx 启动的 stdio 服务）
# [[mcpConfig.servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "C:/data"]
# env = ["LOG_LEVEL=info"]
# allowedTools = ["read_file", "list_directory"]   # 目录类工具建议按需白名单

# [[mcpConfig.servers]]
# name = "fetch"
# command = "uvx"
# args = ["mcp-server-fetch"]


# ============ 熔断器（sony/gobreaker）============
[resilience]
disabled = false
failureThreshold = 5           # 连续失败 5 次跳闸
failureRatio = 0.6             # 或失败率 60%（需 minRequests 以上样本）
minRequests = 10
timeoutSeconds = 30            # open 持续 30 秒后进入 half-open 试探
maxRequestsHalfOpen = 3        # half-open 允许的试探请求数
intervalSeconds = 60           # 关闭态计数窗口滚动周期

# ============ 意图识别（分层：规则层 + LLM 兜底）============
# 规则层（加权词表 + 整词匹配 + 指代/疑问词守卫）永远生效且零成本；
# llmFallback 开启后，规则层"不确定"的少量请求（实测约 7%）才用 LLM 做结构化分类
[intentConfig]
llmFallback = true
cacheTTLSeconds = 600          # 同一问题在此时间内只判一次
maxCacheEntries = 1000

# ============ 限流（令牌桶）============
# 不配这一段时用默认值，行为与历史一致：单用户 10 容量 / 每秒补 2 个（≈2 QPS）。
# 压测时把 enabled 设为 false 临时关掉，压完务必改回 true。
[rateLimit]
enabled = true
capacity = 10                  # 单用户桶容量（突发允许几个请求）
refill = 2                     # 单用户每秒补充 token 数
ipCapacity = 5                 # 未登录接口按 IP：桶容量
ipRefill = 0.2                 # 未登录接口按 IP：每 5 秒补 1 个

# ============ 诊断端点（压测 / 排查用）============
# 打开后会启动 pprof 服务，并开启 goroutine / heap / block / mutex 采样。
# 采样有开销，且 pprof 能 dump 出完整堆栈，生产环境务必保持 false。
[debug]
pprofEnabled = false
pprofAddr = "127.0.0.1:6060"   # 只监听本机；要远程看请走 SSH 隧道
