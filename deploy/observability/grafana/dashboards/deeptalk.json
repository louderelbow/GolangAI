{
  "title": "DeepTalk · AI 应用观测",
  "uid": "deeptalk-overview",
  "description": "容量视角（请求/token/费用）+ 效果视角（工具成功率/步数分布/澄清触发率）。后半部分是 AI 应用区别于普通后端的地方。",
  "tags": [
    "deeptalk",
    "ai-agent",
    "llm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "请求速率",
      "description": "所有 AI 请求的每秒速率（含缓存命中）",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "sum(rate(deeptalk_ai_requests_total[5m]))",
          "legendFormat": "全部请求",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "失败率",
      "description": "status != ok 的占比。含 quota_exceeded（配额拦截是策略，不一定是故障）",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 2,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.02
                },
                {
                  "color": "red",
                  "value": 0.1
                }
              ]
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "(\n  sum(rate(deeptalk_ai_requests_total{status!=\"ok\"}[5m])) / sum(rate(deeptalk_ai_requests_total[5m]))\n)\nand\n(sum(rate(deeptalk_ai_requests_total[5m])) > 0)",
          "legendFormat": "失败率",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agent 工具成功率",
      "description": "status=\"ok\" 的占比。rejected（越界、熔断、配额）单独计，不算故障——否则模型反复试探越界路径会让它看起来像工具坏了",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.8
                },
                {
                  "color": "green",
                  "value": 0.95
                }
              ]
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "(\n  sum(rate(deeptalk_agent_tool_calls_total{status=\"ok\"}[5m])) / sum(rate(deeptalk_agent_tool_calls_total[5m]))\n)\nand\n(sum(rate(deeptalk_agent_tool_calls_total[5m])) > 0)",
          "legendFormat": "成功率",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "澄清触发率",
      "description": "每轮对话里 Agent 决定反问用户的比例。太高说明提示词没收紧，太低说明该问的没问",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "(\n  sum(rate(deeptalk_agent_clarify_total{outcome=\"asked\"}[5m])) / sum(rate(deeptalk_agent_turns_total[5m]))\n)\nand\n(sum(rate(deeptalk_agent_turns_total[5m])) > 0)",
          "legendFormat": "触发率",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "澄清流失率",
      "description": "问了但用户没答的比例。这个数字决定澄清功能该不该留。没有澄清发生时显示 No data —— 0 次澄清的流失率是\"无定义\"，不是 100%",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 1,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.3
                },
                {
                  "color": "red",
                  "value": 0.6
                }
              ]
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "(\n  1 - sum(rate(deeptalk_agent_clarify_total{outcome=\"answered\"}[5m])) / sum(rate(deeptalk_agent_clarify_total{outcome=\"asked\"}[5m]))\n)\nand\n(sum(rate(deeptalk_agent_clarify_total{outcome=\"asked\"}[5m])) > 0)",
          "legendFormat": "流失率",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "本地连接器",
      "description": "在线的工作区连接器数量",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "text",
                  "value": null
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            }
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "max(deeptalk_local_agent_online)",
          "legendFormat": "在线",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "ReAct 步数分布（每轮调用模型几次）",
      "description": "Agent 效率的核心口径。长尾变厚 = 模型在空转（工具描述写得不好，它在瞎试）。注意：步数取自模型调用次数，不是工具调用次数——只想要不想做的 Agent 工具调用很少，那种空转只有看步数才看得出来",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(deeptalk_agent_steps_per_turn_bucket[15m])))\nand\n(sum (rate(deeptalk_agent_steps_per_turn_bucket[15m])) > 0)",
          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(deeptalk_agent_steps_per_turn_bucket[15m])))\nand\n(sum (rate(deeptalk_agent_steps_per_turn_bucket[15m])) > 0)",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(deeptalk_agent_steps_per_turn_bucket[15m])))\nand\n(sum (rate(deeptalk_agent_steps_per_turn_bucket[15m])) > 0)",
          "legendFormat": "p99",
          "editorMode": "code",
          "range": true
        }
      ]
    },
