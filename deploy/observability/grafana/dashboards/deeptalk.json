    {
      "id": 9,
      "type": "timeseries",
      "title": "工具调用速率（按工具与结局）",
      "description": "status 的四种值：ok / error（意外）/ timeout / rejected（按策略拒绝：路径越界、熔断打开）。rejected 单列是刻意的，混进 error 会让成功率失去意义",
      "datasource": {
        "type": "prometheus",
        "uid": "deeptalk-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
