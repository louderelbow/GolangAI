          "expr": "histogram_quantile(0.99, sum by (le) (rate(deeptalk_agent_turn_duration_seconds_bucket[5m])))\nand\n(sum (rate(deeptalk_agent_turn_duration_seconds_bucket[5m])) > 0)",
          "legendFormat": "p99",
