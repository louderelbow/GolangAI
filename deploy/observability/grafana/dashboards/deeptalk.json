      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "sum by (tool, status) (rate(deeptalk_agent_tool_calls_total{tool!=\"none\"}[5m]))",
          "legendFormat": "{{tool}} · {{status}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
