          "legendFormat": "p50",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "deeptalk-prom"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(deeptalk_agent_turn_duration_seconds_bucket[5m])))\nand\n(sum (rate(deeptalk_agent_turn_duration_seconds_bucket[5m])) > 0)",
          "legendFormat": "p95",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
